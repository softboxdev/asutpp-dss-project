DOCUMENTS_DIR=data/raw
MODELS_DIR=models
CACHE_DIR=data/cache

# ML
ML_DEVICE=cuda
ML_BATCH_SIZE=32
ML_NUM_WORKERS=4

# DSAL
DSAL_ENABLED=true
DSAL_SYNTHETIC_RATIO=0.3

# UI
STREAMLIT_PORT=8501
API_PORT=8000