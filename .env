# ============================================================
# КОНФИГУРАЦИЯ ЛОКАЛЬНОГО ПРОЕКТА
# ============================================================

# AI Service (Ollama)
AI_HOST=localhost
AI_PORT=11434
AI_MODEL=deepseek-r1:7b
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1
AI_CACHE_DIR=models/ai_server/cache
AI_CONFIDENCE_THRESHOLD=0.85

# Общие настройки
APP_NAME=ASUTP-DSS-Local
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Хранилище
SQLITE_PATH=data/asutp.db
DOCUMENTS_DIR=data/raw
MODELS_DIR=models
CACHE_DIR=data/cache

# ML
ML_DEVICE=cuda
ML_BATCH_SIZE=32
ML_NUM_WORKERS=4

# DSAL
DSAL_ENABLED=true
DSAL_SYNTHETIC_RATIO=0.3
DSAL_ACTIVE_LEARNING_INTERVAL=10

# UI
STREAMLIT_PORT=8501
API_PORT=8000
